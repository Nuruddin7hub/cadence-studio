{
  "id": "./",
  "name": "Cadence Studio",
  "short_name": "Cadence",
  "description": "Time-blocking calendar, natural-language tasks, Pomodoro sprints, and daily habit streaks built for focused execution.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#090B0E",
  "theme_color": "#090B0E",
  "categories": ["productivity", "utilities", "lifestyle"],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Planner Calendar",
      "short_name": "Planner",
      "description": "Jump straight to the day and week time-blocking timeline",
      "url": "./?tab=planner",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Tasks & Matrix",
      "short_name": "Tasks",
      "description": "Manage Smart List, Kanban board, and Eisenhower matrix",
      "url": "./?tab=tasks",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Focus & Streaks",
      "short_name": "Focus",
      "description": "Start a Pomodoro sprint and claim today's check-in",
      "url": "./?tab=focus",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
